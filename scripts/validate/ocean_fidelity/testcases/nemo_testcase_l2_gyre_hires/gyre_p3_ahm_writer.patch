+   SUBROUTINE l4_dump_ahm( kstp, klevel )
+      INTEGER, INTENT(in) :: kstp, klevel
+      INTEGER :: iunit, ios
+      CHARACTER(LEN=96) :: filename
+      CHARACTER(LEN=16) :: magic
+      IF( .NOT. lwp )   RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'lane4 AHM dump requires 64-bit wp' )
+      WRITE(filename,'("oracle_ahm_kt",I8.8,".bin")') kstp
+      OPEN( NEWUNIT=iunit, FILE=TRIM(filename), ACCESS='STREAM', FORM='UNFORMATTED', &
+         &  STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane4 AHM file' )
+      magic = 'NEMO_L4_AHMTF__1'
+      WRITE(iunit) magic, 1, kstp, klevel, jpi, jpj, jpk, STORAGE_SIZE(1._wp)
+      WRITE(iunit) ahmt(:,:,:), ahmf(:,:,:)
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE4_AHM_DUMP ', kstp, klevel, TRIM(filename)
+   END SUBROUTINE l4_dump_ahm
